# Use Supabase as the Postgres backend for the API.
# Replace <YOUR-PASSWORD> with your Supabase DB password.
SUPABASE_DB_URL=postgresql://postgres.inxolpvjbfcalvoscgae:<YOUR-PASSWORD>@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# Enable Postgres at runtime.
DB_BACKEND=postgres

# Use this if Supabase requires TLS with relaxed verification.
PGSSLMODE=no-verify

# Local storage path for SQLite or disk-backed data if using /var/data.
DATA_DIR=/var/data
